# Optional remote evaluation integration. Local deterministic evaluation works when
# this value is absent.
JEV_API_KEY=
JEV_API_URL=https://api.jev.ai/v1/evaluate

# The HTTP port used by Next.js in development, production, and Docker.
PORT=3000

# Optional callback URL for evaluation webhook notifications.
WEBHOOK_URL=

# Optional publishing queue destination; browser settings can override this per request.
POSTROOM_WEBHOOK_URL=
